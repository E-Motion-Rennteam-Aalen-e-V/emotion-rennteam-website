# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored and never committed - see README.md "Content-Pflege"
# for the full setup walkthrough.

# Required in production for correct SEO metadata (canonical URLs, sitemap.xml,
# robots.txt, Open Graph). Must match the real production domain, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://emotion-rennteam.de

# Optional: Google Search Console "HTML tag" verification token (the content
# value of the <meta name="google-site-verification"> tag GSC gives you).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Meta Pixel ID (Meta Business Suite > Events Manager > Pixel).
# When set, the pixel (src/components/MetaPixel.tsx) loads only after a
# visitor accepts marketing cookies in the consent banner - never before,
# per DSGVO. Without it, no pixel script is ever loaded.
NEXT_PUBLIC_META_PIXEL_ID=

# Login username for the CMS admin panel (/admin/login).
CMS_ADMIN_USER=admin

# Password hash for CMS_ADMIN_USER, generated with:
#   npm run cms:hash-password -- "mein-passwort"
CMS_ADMIN_PASSWORD_HASH=

# SICHERHEIT: Einen langen, zufaelligen Wert setzen (mindestens 32 Zeichen).
# Ein leerer Wert ermoeglicht das Faelschen von Sessions!
# Generieren: openssl rand -base64 32
CMS_SESSION_SECRET=

# Optional GitHub integration: when set, every CMS save is committed
# directly to this repository via the GitHub Contents API. Without it,
# changes are only written to the local filesystem.
# Fine-grained personal access token with "Contents: Read and write" on
# this repository: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=Hudnur111
GITHUB_REPO=Website---E-Motion-Rennteam-Aalen-
GITHUB_BRANCH=website

# Required in production: Resend API key for email delivery of form submissions
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_

# Optional: sender email address for form submissions (default: noreply@resend.dev)
# Must be verified in Resend dashboard if not using a Resend subdomain
RESEND_FROM_EMAIL=noreply@emotion-rennteam.de
